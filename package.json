{
  "name": "strange-frontiers-character-creator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --include \"content/**/*.yaml\" src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "eval": "tsx scripts/eval.ts",
    "check-build": "tsx scripts/check-build.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
