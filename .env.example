# Copy this file to .env. .env is gitignored and stays on your machine.

# Which model builds characters: "ollama" (local, free; the default) or
# "anthropic" (the paid Claude API).
SF_PROVIDER=ollama

# Ollama: any model you've pulled that supports tools (ollama list).
OLLAMA_MODEL=qwen3:30b-a3b
OLLAMA_HOST=http://127.0.0.1:11434
# "tools" (default): native tool calling, which qwen3:30b-a3b handles well.
# "json": the model answers with a whole build and the engine replies with
# errors, for models that don't call tools. deepseek-r1:14b is available
# (OLLAMA_MODEL=deepseek-r1:14b, OLLAMA_MODE=json) but didn't reach a legal
# build in testing.
OLLAMA_MODE=tools

# Claude API, only used with SF_PROVIDER=anthropic. Never reaches the browser.
ANTHROPIC_API_KEY=
# Which Claude model the builder uses: claude-haiku-5-5 (the default),
# claude-sonnet-5-5 or claude-opus-5-5. npm run eval uses --model instead.
ANTHROPIC_MODEL=
