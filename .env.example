# Copy this file to .env. .env is gitignored and stays on your machine.

# Which model builds characters: "ollama" (local, free; the default) or
# "anthropic" (the paid Claude API).
SF_PROVIDER=ollama

# Ollama: any model you've pulled that supports tools (ollama list).
OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_HOST=http://127.0.0.1:11434
# "json" (default): the model answers with a full build and the engine replies
# with errors; works with any model. "tools": native tool calling, for models
# that handle it well (qwen3:30b-a3b does; deepseek-r1:14b doesn't).
OLLAMA_MODE=json

# Claude API, only used with SF_PROVIDER=anthropic. Never reaches the browser.
ANTHROPIC_API_KEY=
